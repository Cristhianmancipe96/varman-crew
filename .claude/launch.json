{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "varman-app",
      "runtimeExecutable": "python",
      "runtimeArgs": ["app/servidor.py"],
      "port": 8000
    },
    {
      "name": "varman-app-dev",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-c", "import os,http.server,socketserver;port=int(os.environ.get('PORT','8890'));os.chdir('app');socketserver.TCPServer(('',port),http.server.SimpleHTTPRequestHandler).serve_forever()"],
      "autoPort": true
    },
    {
      "name": "varman-web-dev",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-c", "import os,http.server,socketserver;port=int(os.environ.get('PORT','8891'));os.chdir('web/publicar');socketserver.TCPServer(('',port),http.server.SimpleHTTPRequestHandler).serve_forever()"],
      "autoPort": true
    }
  ]
}
